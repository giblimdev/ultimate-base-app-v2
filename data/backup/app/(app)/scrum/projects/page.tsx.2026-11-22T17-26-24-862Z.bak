import { Suspense } from "react";
import Link from "next/link";
import { FolderKanban, Plus, Upload } from "lucide-react";
import { listScrumProjects } from "@/lib/scrum/queries";
import { ProjectSummaryCard } from "@/components/scrum/ProjectSummaryCard";
import { Button } from "@/components/ui/button";

async function ProjectsContent() {
  const projects = await listScrumProjects();

  if (projects.length === 0) {
    return (
      <div className="flex flex-col items-center gap-3 rounded-2xl border border-dashed border-border bg-card/50 px-4 py-14 text-center">
        <span
          className="flex size-11 items-center justify-center rounded-xl bg-muted text-muted-foreground"
          aria-hidden="true"
        >
          <FolderKanban className="size-5" />
        </span>
        <h2 className="text-base font-semibold">
          Aucun projet pour l&apos;instant
        </h2>
        <p className="max-w-sm text-sm text-muted-foreground">
          Créez votre premier projet Scrum pour commencer à décrire vos
          features, epics, user stories et sprints.
        </p>
        <div className="flex flex-wrap gap-2">
          <Button
            nativeButton={false}
            variant="outline"
            render={<Link href="/scrum/projects/import" />}
          >
            <Upload className="size-4" aria-hidden />
            Importer
          </Button>
          <Button
            nativeButton={false}
            render={<Link href="/scrum/projects/new" />}
          >
            <Plus className="size-4" aria-hidden />
            Nouveau projet
          </Button>
        </div>
      </div>
    );
  }

  return (
    <ul className="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <li key={project.id} className="min-w-0">
          <Link
            href={`/scrum/projects/${project.id}`}
            aria-label={`Ouvrir le projet ${project.name}`}
            className="block h-full rounded-xl transition-shadow hover:shadow-md focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
          >
            <ProjectSummaryCard project={project} />
          </Link>
        </li>
      ))}
    </ul>
  );
}

export default function ProjectsPage() {
  return (
    <div className="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
      <header className="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div className="flex flex-col gap-1">
          <h1 className="text-2xl font-semibold tracking-tight sm:text-3xl">
            Projets Scrum
          </h1>
          <p className="text-sm text-muted-foreground">
            Vos projets, de la feature à la tâche.
          </p>
        </div>
        <Button
          nativeButton={false}
          className="w-fit"
          render={<Link href="/scrum/projects/new" />}
        >
          <Plus className="size-4" aria-hidden />
          Nouveau projet
        </Button>
      </header>

      <Suspense
        fallback={
          <p className="text-sm text-muted-foreground">
            Chargement des projets…
          </p>
        }
      >
        <ProjectsContent />
      </Suspense>
    </div>
  );
}
