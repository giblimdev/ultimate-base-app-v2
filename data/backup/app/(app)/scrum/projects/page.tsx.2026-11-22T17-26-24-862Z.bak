/*
path :           app/(app)/scrum/projects/page.tsx
tag :            ["scrum", "projects", "list", "page", "server", "crud"]
projectId:       <UltimateBaseApp>
type:            page
generic:         false

role:            Page liste des projets Scrum (/scrum/projects). Server
                 Component wrapper avec <Suspense> (requis par Next.js 16 +
                 cacheComponents : l'appel DB listScrumProjects doit se faire
                 sous une limite Suspense). Le composant enfant ProjectsContent
                 charge les projets, affiche une grille de ProjectSummaryCard
                 cliquables (lien vers le hub du projet), un bouton « Nouveau
                 projet » et un état vide. Remplace l'ancien contenu dupliqué
                 de new/page.tsx.

flow:            ProjectsPage() → <Suspense fallback> → ProjectsContent() →
                 listScrumProjects() → si vide : état vide + CTA → sinon :
                 grille <Link><ProjectSummaryCard/></Link>.

ecosystem:       Scrum = [
                   "@/app/(app)/scrum/actions/dnd.ts",
                   "@/app/(app)/scrum/actions/epic.ts",
                   "@/app/(app)/scrum/actions/feature.ts",
                   "@/app/(app)/scrum/actions/persona.ts",
                   "@/app/(app)/scrum/actions/project.ts",
